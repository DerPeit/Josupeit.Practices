<#@ template debug="false" hostspecific="true" language="C#" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System" #>
<#@ import namespace="System.IO" #>
using System;
using JetBrains.Annotations;
using Josupeit.Practices.Disposables;

namespace Josupeit.Practices.Services;

<#
foreach (var className in new[] { "Service", "DisposableService", "AsyncDisposableService" })
{
    if (className == "AsyncDisposableService")
        #>#if NETSTANDARD2_1_OR_GREATER || NETCOREAPP3_0_OR_GREATER

<#
#>
/// <summary>
<#= className switch
{
    "Service" => "/// This class is a base class and represents a service.",
    "DisposableService" => "/// This class is a base class and represents a service which owns resources that needs to be released.",
    "AsyncDisposableService" => "/// This class is a base class and represents a service which owns resources that needs to be released asynchronously.",
    _ => throw new NotImplementedException(),
} #>
/// </summary>
/// <seealso cref="IService" />
[PublicAPI]
public abstract partial class <#= className #> : <#= className switch { "DisposableService" => "ImplicitDisposable, ", "AsyncDisposableService" => "ImplicitAsyncDisposable, ", _ => "" } #>IService
{
    private volatile IServiceState _state;

    /// <summary>
    /// Initializes a new instance of the <see cref="Service"/> class.
    /// </summary>
    protected <#= className #>()
    {
        _state = new StoppedServiceState(this);
    }

    /// <summary>
    /// Gets a value indicating whether this instance can be paused.
    /// </summary>
    /// <value><c>true</c> if this instance can be paused; otherwise, <c>false</c>.</value>
    /// <remarks>
    /// Derived classes can override this property to indicate that this instance can
    /// be paused. If so, this base class will take care of calling the <see cref="OnPause()"/>
    /// and <see cref="OnResume()"/> methods respectively. Otherwise, calls to <see cref="Pause"/>
    /// and <see cref="Resume"/> will throw a <see cref="NotSupportedException"/>.
    /// </remarks>
    public virtual bool CanPause => false;

    /// <inheritdoc />
    public ServiceState State => _state.State;

    /// <inheritdoc />
    public void Pause()
    {
        if (!CanPause)
            throw new NotSupportedException(
                $"This instance of {GetType()} cannot pause.");

        _state.Pause();
    }

    /// <inheritdoc />
    public void Resume()
    {
        if (!CanPause)
            throw new NotSupportedException(
                $"This instance of {GetType()} cannot pause and thus can also not resume.");

        _state.Resume();
    }

    /// <inheritdoc />
    public void Start() => _state.Start();

    /// <inheritdoc />
    public void Stop() => _state.Stop();

    /// <summary>
    /// Called when this instance is being paused.
    /// </summary>
    protected internal virtual void OnPause()
    {
    }

    /// <summary>
    /// Called when this instance is being resumed.
    /// </summary>
    protected internal virtual void OnResume()
    {
    }

    /// <summary>
    /// Called when this instance is being started.
    /// </summary>
    protected internal abstract void OnStart();

    /// <summary>
    /// Called when this instance is being stopped.
    /// </summary>
    protected internal abstract void OnStop();

    /// <summary>
    /// Throws an <see cref="InvalidOperationException"/> if this instance is being paused or paused.
    /// </summary>
    protected void ThrowIfPaused()
    {
        var state = _state;

        state.ThrowIfPausing();
        state.ThrowIfPaused();
    }

    /// <summary>
    /// Throws an <see cref="InvalidOperationException"/> if this instance is being started, being resumed or running.
    /// </summary>
    protected void ThrowIfRunning()
    {
        var state = _state;

        state.ThrowIfStarting();
        state.ThrowIfResuming();
        state.ThrowIfRunning();
    }

    /// <summary>
    /// Throws an <see cref="InvalidOperationException"/> if this instance is starting, being paused, paused,
    /// being resumed, being stopped or stopped.
    /// </summary>
    protected void ThrowIfNotRunning()
    {
        var state = _state;

        state.ThrowIfStarting();
        state.ThrowIfPausing();
        state.ThrowIfPaused();
        state.ThrowIfResuming();
        state.ThrowIfStopping();
        state.ThrowIfStopped();
    }

    /// <summary>
    /// Throws an <see cref="InvalidOperationException"/> if this instance is being stopped or stopped.
    /// </summary>
    protected void ThrowIfStopped()
    {
        var state = _state;

        state.ThrowIfStopping();
        state.ThrowIfStopped();
    }
}

public abstract partial class <#= className #> : IServiceInternals
{
    void IServiceInternals.OnPause() => OnPause();

    void IServiceInternals.OnResume() => OnResume();

    void IServiceInternals.OnStart() => OnStart();

    void IServiceInternals.OnStop() => OnStop();

    void IServiceInternals.TransitionTo(IServiceState nextState) => _state = nextState;
}

<#
    if (className == "AsyncDisposableService")
        #>#endif
<#
}
#>
