<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>Enable</Nullable>
    <TargetFrameworks>netstandard1.1;netstandard2.0;netstandard2.1;net40;netcoreapp3.0;netcoreapp3.1</TargetFrameworks>
    <RootNamespace>Josupeit.Practices.Disposables</RootNamespace>
    <Authors>Manuel Josupeit-Walter</Authors>
    <Company>Manuel Josupeit-Walter, Freelancing Developer</Company>
    <Product>Manuel Josupeit-Walter, Practices and Patterns</Product>
    <Copyright>Manuel Josupeit-Walter</Copyright>
    <PackageLicenseExpression>EUPL-1.2</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <NeutralLanguage>en-US</NeutralLanguage>
    <IncludeSymbols>True</IncludeSymbols>
    <IncludeSource>True</IncludeSource>
  </PropertyGroup>

  <Choose>
    <When Condition="'$(TargetFramework)' == 'netstandard1.1' Or '$(TargetFramework)' == 'netstandard2.0' Or '$(TargetFramework)' == 'net40'">
      <ItemGroup>
        <Compile Remove="ExplicitAsyncDisposable.cs" />
        <Compile Remove="ImplicitAsyncDisposable.cs" />
      </ItemGroup>

      <ItemGroup>
        <None Include="ExplicitAsyncDisposable.cs" />
        <None Include="ImplicitAsyncDisposable.cs" />
      </ItemGroup>
    </When>
  </Choose>

  <ItemGroup>
    <ProjectReference Include="..\Josupeit.Practices.Disposables.Abstractions\Josupeit.Practices.Disposables.Abstractions.csproj" />
  </ItemGroup>

</Project>
