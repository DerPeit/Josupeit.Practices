<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Generation\Template.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Attributes.cs" />
    <EmbeddedResource Include="Generation\Template.cs" />
  </ItemGroup>

  <ItemGroup Label="Generator compile-time references">
    <PackageReference Include="PolySharp" Version="1.15.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Label="Generator run-time references">
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.3.1" /><!-- Update wisely. Restricts compatible Roslyn version. -->
  </ItemGroup>

</Project>
