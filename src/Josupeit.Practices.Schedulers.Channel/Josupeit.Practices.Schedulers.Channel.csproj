<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netcoreapp3.0;netstandard2.0;netstandard2.1</TargetFrameworks>
    <RootNamespace>Josupeit.Practices.Schedulers</RootNamespace>
    <Description>Channel-backed IScheduler with FIFO ordering, configurable parallelism, back-pressure, and pause/resume support. Built on System.Threading.Channels.</Description>
    <PackageTags>scheduler channel concurrency fifo background-service patterns</PackageTags>
    <PackageVersionTagPrefix>Schedulers.Channel/v</PackageVersionTagPrefix>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nito.AsyncEx.Coordination" Version="[5, 6)" />
    <PackageReference Include="System.Threading.Channels" Version="[4.5.0, 8)" Condition="'$(TargetFramework)' == 'netstandard2.0' or '$(TargetFramework)' == 'netstandard2.1'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Josupeit.Practices.Schedulers\Josupeit.Practices.Schedulers.csproj" PackageVersion="[1-0,2)" />
    <ProjectReference Include="..\Josupeit.Practices.Services\Josupeit.Practices.Services.csproj" PackageVersion="[1-0,2)" />
  </ItemGroup>

</Project>
