<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <Authors>Manuel Josupeit-Walter</Authors>
    <Company>Manuel Josupeit-Walter, Freelancing Developer</Company>
    <Product>Manuel Josupeit-Walter, Practices and Patterns</Product>
    <Copyright>© 2026 Manuel Josupeit-Walter</Copyright>
    <PackageLicenseExpression>EUPL-1.2</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://codeberg.org/DerPeit/Josupeit.Practices</PackageProjectUrl>
    <RepositoryUrl>https://codeberg.org/DerPeit/Josupeit.Practices</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile Condition="Exists('README.md')">README.md</PackageReadmeFile>
    <PackageIcon>Icon.png</PackageIcon>
    <GenerateSBOM Condition="'$(IsPackable)' == 'true'">true</GenerateSBOM>
    <NeutralLanguage>en</NeutralLanguage>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IncludeSource>true</IncludeSource>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <AnalysisLevel>latest</AnalysisLevel>
    <NoWarn>$(NoWarn);NETSDK1138;NETSDK1215;SA1649;CA1032</NoWarn>
    <PackageVersionTagPrefix />
    <PackageReleaseNotesGitPath>. ../Directory.Build.props ../Directory.Build.targets</PackageReleaseNotesGitPath>
  </PropertyGroup>

  <!--
    On modern target frameworks, turn on the full trim / AOT / single-file analyzer suite so that
    AOT-hostile code is flagged at build time rather than failing at publish. IsAotCompatible also
    marks the assembly trimmable. The netstandard targets cannot carry these analyzers, so the
    condition scopes this to net8.0; it is a no-op for projects without that target framework.
  -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!--
    IsAotCompatible (via IsTrimmable) pulls in Microsoft.NET.ILLink.Tasks, whose version the SDK
    picks from the build environment's .NET 8 servicing band. That makes packages.lock.json
    host-specific and fails RestoreLockedMode on CI with NU1004. Pinning it explicitly keeps the
    restore graph identical everywhere, the same rationale as Microsoft.NETFramework.ReferenceAssemblies
    in test/Directory.Build.props.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.NET.ILLink.Tasks" Version="8.0.31">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" Condition="Exists('README.md')" />
    <None Include="llms.txt" Pack="true" PackagePath="\" Condition="Exists('llms.txt')" />
    <None Include="llms-full.txt" Pack="true" PackagePath="\" Condition="Exists('llms-full.txt')" />
    <None Include="$(MSBuildThisFileDirectory)..\LICENSE.md" Pack="true" PackagePath="\" Link="LICENSE.md" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)..\Icon.png" Pack="true" PackagePath="\" Link="Icon.png" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <SourceLinkGiteaHost Include="codeberg.org" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ConfigureAwaitChecker.Analyzer" Version="*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <PackageReference Include="JetBrains.Annotations" Version="*">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    
    <PackageReference Include="Microsoft.Sbom.Targets" Version="*">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    
    <PackageReference Include="Microsoft.SourceLink.Gitea" Version="*">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    
    <PackageReference Include="Nerdbank.GitVersioning" Version="3.*">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    
    <PackageReference Include="StyleCop.Analyzers" Version="[1.2.0-beta.556,2)">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.*" Condition="'$(EnablePublicApiAnalyzers)' != 'false'">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
  </ItemGroup>

  <ItemGroup Condition="'$(EnablePublicApiAnalyzers)' != 'false'">
    <AdditionalFiles Include="PublicAPI.Shipped.$(TargetFramework).txt" Condition="Exists('$(MSBuildProjectDirectory)\PublicAPI.Shipped.$(TargetFramework).txt')" />
    <AdditionalFiles Include="PublicAPI.Unshipped.$(TargetFramework).txt" Condition="Exists('$(MSBuildProjectDirectory)\PublicAPI.Unshipped.$(TargetFramework).txt')" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)ThrowIfNullExtension.cs" Link="Properties\ThrowIfNullExtension.cs" />
  </ItemGroup>

</Project>