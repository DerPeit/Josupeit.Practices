<#@ template debug="false" hostspecific="true" language="C#" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System" #>
<#@ import namespace="System.IO" #>
using JetBrains.Annotations;

#nullable enable

namespace Josupeit.Practices.Jobs;

<#
foreach (var (isProgress, isResult) in new[] { (false, false), (false, true), (true, false), (true, true) })
{
    var className = (isProgress, isResult) switch
    {
        (false, false) => "Job",
        (false, true) => "JobWithResult<TResult>",
        (true, false) => "JobWithProgress<TProgress>",
        (true, true) => "JobWithProgressAndResult<TProgress, TResult>",
    };

#>
/// <summary>
/// This class is a base class for a job
<#
    switch ((isProgress, isResult))
    {
        case (false, false):
#>
/// </summary>
<#
            break;

        case (false, true):
#>
/// with a result.
/// </summary>
/// <typeparam name="TResult">The type of the result.</typeparam>
<#
            break;

        case (true, false):
#>
/// with a progress.
/// </summary>
/// <typeparam name="TProgress">The type of the progress.</typeparam>
<#
            break;

        case (true, true):
#>
/// with a progress and a result.
/// </summary>
/// <typeparam name="TProgress">The type of the progress.</typeparam>
/// <typeparam name="TResult">The type of the result.</typeparam>
<#
            break;

    }
#>
[PublicAPI]
public abstract class <#= className #> : JobBase, I<#= className #>
{
<#
    if (isProgress)
    {
#>
    /// <inheritdoc />
    public TProgress? Progress { get; private set; }

    /// <inheritdoc />
    object? IHasProgress.Progress => Progress;

    /// <summary>
    /// Sets the <see cref="Progress" /> property and invokes the <see cref="JobBase.Changed" /> event.
    /// </summary>
    protected void NotifyProgress(TProgress? progress)
    {
        Progress = progress;

        OnChanged();
    }

<#
    }

    if (isResult)
    {
#>
    /// <inheritdoc />
    public TResult? Result { get; private set; }

    /// <inheritdoc />
    object? IHasResult.Result => Result;

<#
    }
#>
    /// <summary>
    /// Sets the <see cref="JobBase.IsExecuting" /> property to <c>false</c>, the <see cref="JobBase.IsCompleted" />
    /// and <see cref="JobBase.IsCompletedSuccessfully"/> properties to
    /// <c>true</c><#= isResult ? ", sets the <see cref=\"Result\" /> property to the value of <paramref name=\"result\" />" : "" #>
    /// and invokes the <see cref="JobBase.Changed" /> event.
    /// </summary>
    public void NotifySucceeded(<#= isResult ? "TResult? result" : "" #>)
    {
        IsCompleted = true;
        IsCompletedSuccessfully = true;
        IsExecuting = false;
<#
    if (isResult)
    {
#>
        Result = result;
<#
    }
#>

        OnChanged();
    }
}
<#
}
#>
