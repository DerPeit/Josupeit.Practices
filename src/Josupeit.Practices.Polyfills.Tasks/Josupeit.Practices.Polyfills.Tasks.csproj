<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 
      .NET 4.5 implements .NET Standard 1.0 and .NET 4.6 implements .NET Standard 1.3.
      However, NuGet (and project package resolution) prefers the .NET 4.0 artifact over
      the .NET Standard artifacts. Thus, we need to specify them explicitly.
    -->
    <TargetFrameworks>net40;net45;net46;netstandard1.0;netstandard1.3</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Bcl.Async" Version="[1.0.16,2)" Condition="'$(TargetFramework)' == 'net40'" />
  </ItemGroup>

  <Choose>
    <When Condition="'$(TargetFramework)' == 'net40'">
      <ItemGroup>
        <Compile Remove="TaskPolyfill.cs" />
        <Compile Remove="TaskPolyfill.NetStandard1_0.cs" />
      </ItemGroup>

      <ItemGroup>
        <None Include="TaskPolyfill.cs" />
        <None Include="TaskPolyfill.NetStandard1_0.cs" />
      </ItemGroup>
    </When>

    <When Condition="'$(TargetFramework)' == 'net45' Or '$(TargetFramework)' == 'netstandard1.0'">
      <ItemGroup>
        <Compile Remove="TaskPolyfill.cs" />
        <Compile Remove="TaskPolyfill.Net40.cs" />
      </ItemGroup>

      <ItemGroup>
        <None Include="TaskPolyfill.cs" />
        <None Include="TaskPolyfill.Net40.cs" />
      </ItemGroup>
    </When>

    <Otherwise>
      <ItemGroup>
        <Compile Remove="TaskPolyfill.Net40.cs" />
        <Compile Remove="TaskPolyfill.NetStandard1_0.cs" />
      </ItemGroup>

      <ItemGroup>
        <None Include="TaskPolyfill.Net40.cs" />
        <None Include="TaskPolyfill.NetStandard1_0.cs" />
      </ItemGroup>
    </Otherwise>
  </Choose>

</Project>
