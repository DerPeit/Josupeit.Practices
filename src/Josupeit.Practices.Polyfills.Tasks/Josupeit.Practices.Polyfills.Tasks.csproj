<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>Enable</Nullable>
    <TargetFrameworks>netstandard1.0;net40;netstandard1.3</TargetFrameworks>
    <Authors>Manuel Josupeit-Walter</Authors>
    <Company>Manuel Josupeit-Walter, Freelancing Developer</Company>
    <Product>Manuel Josupeit-Walter, Practices and Patterns</Product>
    <Copyright>Manuel Josupeit-Walter</Copyright>
    <PackageLicenseExpression>EUPL-1.2</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <NeutralLanguage>en-US</NeutralLanguage>
    <IncludeSymbols>True</IncludeSymbols>
    <IncludeSource>True</IncludeSource>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Bcl.Async" Version="[1.0.16,2)" Condition="'$(TargetFramework)' == 'net40'" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="TaskPolyfill.cs" Condition="'$(TargetFramework)' != 'netstandard1.3'" />
    <Compile Remove="TaskPolyfill.Net40.cs" Condition="'$(TargetFramework)' != 'net40'" />
    <Compile Remove="TaskPolyfill.NetStandard1_0.cs" Condition="'$(TargetFramework)' != 'netstandard1.0'" />
  </ItemGroup>

  <ItemGroup>
    <None Include="TaskPolyfill.cs" Condition="'$(TargetFramework)' != 'netstandard1.3'" />
    <None Include="TaskPolyfill.Net40.cs" Condition="'$(TargetFramework)' != 'net40'" />
    <None Include="TaskPolyfill.NetStandard1_0.cs" Condition="'$(TargetFramework)' != 'netstandard1.0'" />
  </ItemGroup>

</Project>
