<Project>

  <PropertyGroup>
    <!--
      It is very hard to ensure that particular targets only run once per project. Usually, they run once per target framework
      which leads to errors due to locked files or to race conditions. One can check for a so-called "outer build" which is
      the project's build when multi-targeted. Unfortunately, in BeforeBuild targets the outer build comes last. Thus, the
      inner builds are triggered first and afterwards the outer build runs. So, if we attempt to transform tt files to generated
      code we cannot do this in the outer build. Thus, we utilize the DispatchToInnerBuilds target for this case. However, this
      target only runs in multi-targeted projects. That's the reason for the complicated setup. However, the outer build stuff
      works the other way around in the "after" targets. They run first there so we can rely on this in the clean target.
    -->

    <IsMultiTargeted>false</IsMultiTargeted>
    <IsOuterBuild>false</IsOuterBuild>

    <IsMultiTargeted Condition="'$(TargetFrameworks)' != '' AND $(TargetFrameworks.IndexOf(';')) &gt; -1 AND $(TargetFrameworks.IndexOf(';')) != $([MSBuild]::Add($(TargetFrameworks.Length), 1))">true</IsMultiTargeted>
    <IsOuterBuild Condition="!$(IsMultiTargeted) OR '$(TargetFramework)' == ''">true</IsOuterBuild>
  </PropertyGroup>

  <ItemGroup>
    <TextTemplate Include="**\*.tt">
      <SourceFilename>%(Filename).tt</SourceFilename>
      <SourceRelativePath>%(RelativeDir)%(SourceFilename)</SourceRelativePath>
      <DestinationRelativePath>%(RelativeDir)%(Filename).Generated.cs</DestinationRelativePath>
    </TextTemplate>

    <Compile Update="@(TextTemplate->'%(DestinationRelativePath)')">
      <DependentUpon>%(TextTemplate.SourceFilename)</DependentUpon>
    </Compile>
  </ItemGroup>

  <Target Name="TextTemplateTransformSingleTarget" BeforeTargets="BeforeBuild" Condition="!$(IsMultiTargeted)" />
  <Target Name="TextTemplateTransformMultiTarget" BeforeTargets="DispatchToInnerBuilds" Condition="$(IsMultiTargeted)" />

  <Target Name="TextTemplateTransform" BeforeTargets="TextTemplateTransformSingleTarget;TextTemplateTransformMultiTarget" Inputs="@(TextTemplate)" Outputs="@(TextTemplate->'%(DestinationRelativePath)')">
    <Message Text="Transforming '%(TextTemplate.SourceRelativePath)' to '%(TextTemplate.DestinationRelativePath)'." Importance="High" />
    <Exec WorkingDirectory="$(ProjectDir)" Command="dotnet t4 %(TextTemplate.SourceRelativePath) -o %(TextTemplate.DestinationRelativePath)" />
  </Target>

  <Target Name="TextTemplateClean" AfterTargets="Clean" Condition="$(IsOuterBuild)">
    <Delete Files="@(TextTemplate->'%(DestinationRelativePath)')" />
  </Target>

</Project>