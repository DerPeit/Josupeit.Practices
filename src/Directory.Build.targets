<Project>

  <!--
    T4 templates are transformed into $(IntermediateOutputPath), i.e. once per target framework into a directory
    that no other build touches. Generating into the source tree raced: a ProjectReference triggers the referenced
    project's inner build directly, which could compile while the project's own outer build was rewriting the shared
    .g.cs file (CS2001). Inputs/Outputs keep the transform incremental per framework; FileWrites lets Clean remove
    the output. The outer build of a multi-targeted project has no TargetFramework and is skipped. The path uses
    forward slashes because IntermediateOutputPath contains backslashes, which a Linux shell drops from the dotnet t4
    command line.
  -->
  <ItemGroup>
    <TextTemplate Include="**\*.tt">
      <SourceRelativePath>%(RelativeDir)%(Filename).tt</SourceRelativePath>
      <DestinationDir>$(IntermediateOutputPath.Replace('\', '/'))%(RelativeDir)</DestinationDir>
      <DestinationRelativePath>$(IntermediateOutputPath.Replace('\', '/'))%(RelativeDir)%(Filename).g.cs</DestinationRelativePath>
      <LegacyDestinationRelativePath>%(RelativeDir)%(Filename).g.cs</LegacyDestinationRelativePath>
    </TextTemplate>

    <!-- Stale outputs from the former in-tree generation must not be compiled a second time. -->
    <Compile Remove="@(TextTemplate->'%(LegacyDestinationRelativePath)')" />
    <Compile Include="@(TextTemplate->'%(DestinationRelativePath)')">
      <Link>%(TextTemplate.RelativeDir)%(TextTemplate.Filename).g.cs</Link>
      <DependentUpon>%(TextTemplate.Filename).tt</DependentUpon>
    </Compile>
  </ItemGroup>

  <Target Name="TextTemplateTransform" BeforeTargets="BeforeBuild" Condition="'$(TargetFramework)' != ''" Inputs="@(TextTemplate)" Outputs="@(TextTemplate->'%(DestinationRelativePath)')">
    <Message Text="Transforming '%(TextTemplate.SourceRelativePath)' to '%(TextTemplate.DestinationRelativePath)'." Importance="High" />
    <MakeDir Directories="@(TextTemplate->'%(DestinationDir)')" />
    <Exec WorkingDirectory="$(ProjectDir)" Command="dotnet t4 %(TextTemplate.SourceRelativePath) -o %(TextTemplate.DestinationRelativePath)" />

    <ItemGroup>
      <FileWrites Include="@(TextTemplate->'%(DestinationRelativePath)')" />
    </ItemGroup>
  </Target>

  <!--
    Automatically generates PackageReleaseNotes from git commit subjects
    touching this project's path(s), scoped to commits since the previous
    release tag. Requires git in PATH; failures are silently ignored.
  -->
  <Target Name="GeneratePackageReleaseNotes" BeforeTargets="GenerateNuspec"
          Condition="'$(IsPackable)' == 'true' AND '$(PackageVersionTagPrefix)' != ''">

    <PropertyGroup>
      <_NullDevice Condition="'$(OS)' == 'Windows_NT'">nul</_NullDevice>
      <_NullDevice Condition="'$(OS)' != 'Windows_NT'">/dev/null</_NullDevice>

      <_GitFormatPercent Condition="'$(OS)' == 'Windows_NT'">%%</_GitFormatPercent>
      <_GitFormatPercent Condition="'$(OS)' != 'Windows_NT'">%</_GitFormatPercent>
    </PropertyGroup>

    <Exec Command="git describe --tags --match &quot;$(PackageVersionTagPrefix)*&quot; --abbrev=0 HEAD~1 2&gt;$(_NullDevice)"
          ConsoleToMSBuild="true"
          IgnoreExitCode="true"
          WorkingDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="_PreviousReleaseTag" />
    </Exec>

    <PropertyGroup>
      <_PreviousReleaseTag>$(_PreviousReleaseTag.Trim())</_PreviousReleaseTag>

      <_ReleaseNotesRange Condition="'$(_PreviousReleaseTag)' != ''">$(_PreviousReleaseTag)..HEAD</_ReleaseNotesRange>
      <_ReleaseNotesRange Condition="'$(_PreviousReleaseTag)' == ''">HEAD</_ReleaseNotesRange>
    </PropertyGroup>

    <Exec Command="git log --pretty=format:&quot;- $(_GitFormatPercent)s&quot; $(_ReleaseNotesRange) -- $(PackageReleaseNotesGitPath)"
          ConsoleToMSBuild="true"
          IgnoreExitCode="true"
          WorkingDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="ConsoleOutput" ItemName="_PackageReleaseNoteLines" />
    </Exec>

    <PropertyGroup>
      <PackageReleaseNotes>@(_PackageReleaseNoteLines, '%0a')</PackageReleaseNotes>
    </PropertyGroup>

  </Target>

  <!--
    Applies the PackageVersion attribute from each ProjectReference to the corresponding
    _ProjectReferencesWithVersions item that NuGet uses when generating the .nuspec file.
    "~" is a placeholder for the smallest version the referenced assembly binds to. Assemblies are
    stamped major.minor.0.0 (nbgv assemblyVersion precision "minor"; adjust the regex below if that
    changes), so that is the referenced project's major.minor - or its full version while it is a
    prerelease, so that develop builds can still be consumed from a local feed.
    Source: https://stackoverflow.com/a/73098203
  -->
  <Target Name="UseExplicitPackageVersions" BeforeTargets="GenerateNuspec">
    <ItemGroup>
      <_ProjectReferencesWithVersions Condition="'%(FullPath)' != ''">
        <PackageVersion>@(ProjectReference->'%(PackageVersion)')</PackageVersion>
      </_ProjectReferencesWithVersions>
      <_ProjectReferencesWithVersions Condition="'%(Identity)' != ''">
        <_BindingVersion Condition="!$([System.String]::new('%(ProjectVersion)').Contains('-'))">$([System.Text.RegularExpressions.Regex]::Match('%(ProjectVersion)', '^\d+\.\d+').Value)</_BindingVersion>
        <_BindingVersion Condition="$([System.String]::new('%(ProjectVersion)').Contains('-'))">%(ProjectVersion)</_BindingVersion>
      </_ProjectReferencesWithVersions>
      <_ProjectReferencesWithVersions Condition="'%(Identity)' != '' And '%(PackageVersion)' != ''">
        <ProjectVersion>$([System.String]::new('%(PackageVersion)').Replace('~', '%(_BindingVersion)'))</ProjectVersion>
      </_ProjectReferencesWithVersions>
    </ItemGroup>
  </Target>

</Project>