<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Native AOT regression gate. This is not a usage sample: it is published with PublishAot and run
    as a native binary in CI (see .forgejo/workflows/ci.yml). IlcTreatWarningsAsErrors turns any
    reachable trim/AOT IL warning into a publish failure, and TrimmerSingleWarn=false keeps each
    warning individually reported instead of collapsed. It exercises the runtime libraries' primary
    public API so the AOT compiler has to compile those paths natively.

    It deliberately lives outside src/ and test/ so it inherits neither the packaging props nor the
    NUnit/NSubstitute test harness, and it is kept out of the solution so the normal build, test, and
    pack flow does not pull in the AOT toolchain. It targets net10.0 (the CI SDK) and consumes the
    libraries' net8.0 assets, which are the AOT-marked ones.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>

    <PublishAot>true</PublishAot>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Josupeit.Practices.Specifications\Josupeit.Practices.Specifications.csproj" />
    <ProjectReference Include="..\..\src\Josupeit.Practices.Commands\Josupeit.Practices.Commands.csproj" />
    <ProjectReference Include="..\..\src\Josupeit.Practices.Services\Josupeit.Practices.Services.csproj" />
    <ProjectReference Include="..\..\src\Josupeit.Practices.Schedulers.TaskPool\Josupeit.Practices.Schedulers.TaskPool.csproj" />
    <ProjectReference Include="..\..\src\Josupeit.Practices.Schedulers.Channel\Josupeit.Practices.Schedulers.Channel.csproj" />
    <ProjectReference Include="..\..\src\Josupeit.Practices.Jobs.TaskPool\Josupeit.Practices.Jobs.TaskPool.csproj" />
    <ProjectReference Include="..\..\src\Josupeit.Practices.Jobs.Scheduler\Josupeit.Practices.Jobs.Scheduler.csproj" />
  </ItemGroup>

</Project>
