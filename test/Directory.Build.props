<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Threading" />
    <Using Include="NSubstitute" />
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" Version="*">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- netcoreapp2.2: pin to latest compatible versions -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netcoreapp2.2'">
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="16.11.0" />
    <PackageReference Include="NSubstitute" Version="2.0.3" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="3.17.0" />
  </ItemGroup>

  <!-- All other frameworks -->
  <ItemGroup Condition="'$(TargetFramework)' != 'netcoreapp2.2'">
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.*" />
    <PackageReference Include="NSubstitute" Version="6.*" />
    <PackageReference Include="NUnit" Version="4.*" /><!-- Major pinned: netcoreapp2.2 stays on NUnit 3, so shared test code must compile on both. -->
    <PackageReference Include="NUnit3TestAdapter" Version="6.*" /><!-- Tracks the Microsoft test platform, not NUnit: 5.x moved the test host to Microsoft.Testing.Platform. -->
  </ItemGroup>

  <!--
    On non-Windows hosts the SDK adds this implicitly for net4x targets, but on Windows it
    resolves the installed targeting pack instead and adds nothing. That asymmetry makes
    packages.lock.json host-specific and fails RestoreLockedMode on a Linux CI runner with
    NU1004. Declaring it explicitly keeps the graph identical everywhere; the SDK skips its
    own implicit reference when one is already present.
  -->
  <ItemGroup Condition="$(TargetFramework.StartsWith('net4'))">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
